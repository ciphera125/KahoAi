# Copy to .env and fill in. Never commit .env.

# --- Deepgram (speech-to-text) ---
# "multi" lets nova-3 code-switch between Hindi and English mid-sentence;
# use "en-IN" instead to pin it to Indian English.
# DEEPGRAM_KEYTERMS is a comma-separated list of words to bias nova-3 toward —
# brand, place, product and people names it would otherwise mangle. This is the
# main lever on mis-transcription, so fill it in for your use case.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_KEYTERMS=Kaho

# --- Latency tuning ---
# These are starting points, not answers. Change one at a time, make a few real
# calls, and read scripts/latency_summary.py before and after.
#
# VAD_STOP_SECS is how long the caller must go quiet before we treat their turn
# as over, so it is added to every single reply. Lower feels snappier but cuts
# people off mid-sentence when they pause to recall a date or an amount; higher
# makes every answer drag. Try 0.2 to 0.5 against recordings of real callers.
VAD_STOP_SECS=0.25
VAD_START_SECS=0.2
VAD_CONFIDENCE=0.7
VAD_MIN_VOLUME=0.6
#
# TTS_TEXT_AGGREGATION: "sentence" speaks each sentence as the model finishes
# it, so the caller hears sentence one while sentence two is still being
# written. "token" starts sooner still, but the voice has to pick an intonation
# before it knows how the sentence ends, which is what sounds choppy.
TTS_TEXT_AGGREGATION=sentence
#
# Where per-turn timings are written for scripts/latency_summary.py.
LATENCY_LOG_PATH=logs/turns.jsonl

# --- TTS provider selection ---
# "deepgram" reuses the STT key above and costs nothing extra to iterate
# against, but Aura's voices are English-only. Switch to "sarvam", "smallest"
# or "elevenlabs" for Hindi and the other Indian languages.
TTS_PROVIDER=deepgram

# --- Deepgram Aura (text-to-speech) ---
# DEEPGRAM_VOICE_ID is an Aura voice name, e.g. aura-2-thalia-en.
DEEPGRAM_VOICE_ID=aura-2-thalia-en

# --- Sarvam (text-to-speech, Indian languages) ---
# Set TTS_PROVIDER=sarvam to use this. Unlike Aura it speaks Hindi and the
# other Indic languages, so it is the way out of the English-only limit.
# SARVAM_VOICE_ID is a bulbul:v3 speaker name: shubh, aditya, ritu, priya,
# neha, rahul, pooja, rohan, simran, kavya, amit, dev, ishita, shreya, ratan,
# varun, manan, sumit, roopa, kabir, aayan, ashutosh, advait.
# SARVAM_LANGUAGE is a BCP-47 code such as hi-IN or en-IN.
# SARVAM_PACE is 0.5 to 2.0.
#
# Sarvam is the one provider here with a real character buffer, which is the
# knob Deepgram does not expose. MIN_BUFFER_SIZE is how much text it gathers
# before it starts speaking: smaller starts sooner but gives the voice less to
# plan intonation with, which is what makes short fragments sound clipped.
# Sarvam's own defaults are 50 and 150; leave blank to use them.
SARVAM_API_KEY=
SARVAM_VOICE_ID=priya
SARVAM_MODEL_ID=bulbul:v3
SARVAM_LANGUAGE=hi-IN
SARVAM_PACE=1.0
SARVAM_MIN_BUFFER_SIZE=
SARVAM_MAX_CHUNK_LENGTH=

# --- Smallest AI (text-to-speech, Hindi and English) ---
# Set TTS_PROVIDER=smallest to A/B its Hindi voices against Sarvam's.
# SMALLEST_MODEL_ID is lightning_v3.1 or lightning_v3.1_pro.
# SMALLEST_VOICE_ID: Pipecat lists meher, devansh, kartik, maithili (Hindi and
# English) plus liam and avery (English) as the voices with word timestamps;
# sophia is the lightning_v3.1 default. Check Smallest's voice list for the rest.
# SMALLEST_LANGUAGE is a short code such as hi or en; the voice follows the
# caller's language per turn when TTS_FOLLOW_CALLER_LANGUAGE is on.
# SMALLEST_SPEED is 0.5 to 2.0.
# SMALLEST_MAX_BUFFER_DELAY_MS (0 to 5000) caps how long it holds a text
# fragment before speaking; leave blank for its default of 3000, which is a
# lot of latency to give away.
SMALLEST_API_KEY=
SMALLEST_VOICE_ID=meher
SMALLEST_MODEL_ID=lightning_v3.1_pro
SMALLEST_LANGUAGE=hi
SMALLEST_SPEED=1.0
SMALLEST_MAX_BUFFER_DELAY_MS=

# --- Telephony (Plivo, inbound calls) ---
# Run `python apps/voice/server.py`, expose it publicly (a tunnel such as ngrok
# works locally), and set the Plivo number's Answer URL to
#   https://<PUBLIC_HOST>/answer?token=<WEBHOOK_SECRET>
# PUBLIC_HOST is the bare hostname, no scheme. WEBHOOK_SECRET is any long random
# string (python -c "import secrets; print(secrets.token_urlsafe(32))"); the
# server refuses /answer and /ws without it, since anyone who could open /ws
# could run up the STT, LLM and TTS bills. PLIVO_AUTH_ID / PLIVO_AUTH_TOKEN are
# the account credentials from the Plivo console; the agent uses them to hang up
# the call when the pipeline ends.
PUBLIC_HOST=
WEBHOOK_SECRET=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PORT=8000

# --- LLM provider selection ---
# "groq" for now; "bedrock" once we switch to Claude Haiku 4.5 on AWS.
LLM_PROVIDER=groq

# --- Groq (LLM) ---
# Measured on this account (median time to first streamed token, 5 prompts):
#   qwen/qwen3.8-27b      0.31s, worst 0.33s   <- default, fastest that stays sharp
#   openai/gpt-oss-20b    0.50s, worst 0.58s
#   openai/gpt-oss-120b   0.59s, worst 1.65s   <- strongest, but spiky
#   allam-2-7b            0.20s, worst 0.20s   Arabic-first, weaker on odd input
# Re-measure rather than trust this list; swap the model and A/B it yourself.
# GROQ_REASONING_EFFORT trades latency for depth (low/medium/high on gpt-oss
# and qwen3.8-27b). Leave it low, and blank it for a non-reasoning model like
# allam-2-7b, which rejects the parameter outright.
GROQ_API_KEY=
GROQ_MODEL_ID=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=low

# --- AWS Bedrock (Claude Haiku 4.5 LLM) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# --- ElevenLabs (text-to-speech) ---
# flash_v2_5 is the low-latency model (~75ms) and bills at half the credits of
# multilingual_v2, which roughly doubles how many test calls a plan covers.
# Copy the voice ID from your own ElevenLabs dashboard: on the free plan,
# Voice Library voices are rejected over the API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Agent behaviour ---
# AGENT_SYSTEM_PROMPT_PATH is what the agent becomes: point it at any file in
# apps/voice/prompts (or an absolute path) and the agent follows that persona.
# Relative paths resolve against apps/voice. Defaults to prompts/default.md.
# The speaking rules in main.py are always applied on top, so a prompt only has
# to say who the agent is and what it does — not how to sound.
#
# Leave LLM_MAX_TOKENS unset unless you have a reason: on a reasoning model the
# budget covers the thinking tokens too, so a small cap truncates the spoken
# reply or empties it entirely. Measured at 100 tokens with no reasoning_effort,
# gpt-oss-120b cut off mid-sentence and gpt-oss-20b returned nothing at all.
AGENT_SYSTEM_PROMPT_PATH=prompts/default.md
LLM_MAX_TOKENS=
LLM_TEMPERATURE=

# --- General ---
LOG_LEVEL=

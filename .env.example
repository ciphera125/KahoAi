# --- ElevenLabs (text-to-speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Agent behaviour ---
AGENT_SYSTEM_PROMPT_PATH=
LLM_MAX_TOKENS=
LLM_TEMPERATURE=

# --- General ---
LOG_LEVEL=

# Copy to .env and fill in. Never commit .env.

# --- Deepgram (speech-to-text) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
DEEPGRAM_LANGUAGE=

# --- AWS Bedrock (Claude Haiku 4.5 LLM) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=

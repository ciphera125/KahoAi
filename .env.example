# Copy to .env and fill in. Never commit .env.

# --- Deepgram (speech-to-text) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
DEEPGRAM_LANGUAGE=

# --- LLM provider selection ---
# "groq" for now; "bedrock" once we switch to Claude Haiku 4.5 on AWS.
LLM_PROVIDER=

# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL_ID=

# --- AWS Bedrock (Claude Haiku 4.5 LLM) ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# --- ElevenLabs (text-to-speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# --- Agent behaviour ---
AGENT_SYSTEM_PROMPT_PATH=
LLM_MAX_TOKENS=
LLM_TEMPERATURE=

# --- General ---
LOG_LEVEL=

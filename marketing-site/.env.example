# Kaho AI website settings. Copy to .env.local and fill in. Never commit real values.
# All are read at build time (Vite exposes only VITE_* names to the browser).

# Where the booking form's mailto fallback goes. Empty: hello@kaho.ai (the footer's address).
VITE_CONTACT_EMAIL=

# Public demo phone number, e.g. +91 80000 00000. Empty: the "Talk to Kaho" section,
# the "Hear it live" button and the demo line in the FAQ are hidden.
VITE_DEMO_PHONE=

# Cal.com or Calendly page to embed on /book-a-call (https only). Empty: the form is shown.
VITE_BOOKING_URL=

# Endpoint that receives the form as a JSON POST (https only). Empty: the form opens an email instead.
VITE_FORM_ENDPOINT=

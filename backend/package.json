{
  "name": "kaho-studio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kaho AI Studio API: Node + Express, MVC, PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "import:legacy": "node scripts/import-legacy.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}

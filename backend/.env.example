# Kaho AI Studio API. Copy to backend/.env and fill in. Never commit backend/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8020
WEB_CONCURRENCY=1                 # worker processes; set to the CPU count in production
DATABASE_URL=postgres:///kaho_studio
# Supabase: Project Settings > Database > Connection string, the SESSION pooler or
# direct connection (port 5432), never the transaction pooler (6543). TLS is on
# for Supabase hosts automatically; give its CA certificate so the server is
# verified, not just encrypted (Project Settings > Database > SSL, download it):
# DATABASE_SSL_CA=/path/to/prod-ca-2021.crt
# DATABASE_SSL=off|require|verify   # forces a mode for any host
PGPOOL_MAX=10                     # per worker; workers x this must stay under Postgres max_connections
ALLOWED_ORIGINS=http://localhost:5173   # where the React app is served from
# ALLOWED_HOSTS=                  # defaults to localhost/127.0.0.1:PORT plus the origins' hosts
# TRUST_PROXY=true                # only behind a reverse proxy / load balancer you control
# COOKIE_SECURE=true              # default true when NODE_ENV=production
SECRETS_KEY=                      # openssl rand -hex 32  (encrypts provider credentials; keep it safe)
INTERNAL_API_TOKEN=               # openssl rand -hex 32  (shared with the voice service only)
# REDIS_URL=redis://127.0.0.1:6379  # shares rate-limit counts across processes and servers

# Placing calls (the same values as the voice service's .env)
PUBLIC_HOST=                      # the voice server's public host, e.g. abc.ngrok-free.app
WEBHOOK_SECRET=
MAX_CALL_DURATION_SECS=600
PLIVO_FROM_NUMBER=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# BULK_REPEAT_HOURS=24            # nobody is called again by a bulk call within this many hours of any call; 0 turns it off
# BULK_MAX_CONCURRENT=10           # calls at once across every bulk call; the voice server's WS_MAX_CONCURRENT_CALLS
# BULK_OUTSIDE_CAP=6               # most of those slots one organization's hand-placed and inbound calls can take from bulk calls
# TRANSFER_NUMBER=                # makes the transfer tool show as ready
# TOOL_WEBHOOK_URL=               # makes the webhook tool show as ready

# Call recordings (the same project and bucket the voice service uploads to).
# Needed only to play or download a recording in the Studio; the key stays server-side.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The customers' bucket: recordings, transcripts and each organization's records, all spreadsheets (CSV).
SUPABASE_RECORDINGS_BUCKET=kaho-customer-records
# Kaho staff's own records, in a separate bucket: admin activity, organizations and plans, requests, top-ups, people.
SUPABASE_ADMIN_BUCKET=kaho-admin-records
# Cloud recordings are deleted from Storage after this many days (the phone server's local copy has its own setting)
RECORDING_RETENTION_DAYS=60

# "Test this agent" talks to Groq for a short simulated conversation with the draft. Without
# a key the button says so; Publish then needs an admin's override, since it asks for a test.
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-20b
# Publish needs a passing test of exactly the draft being published. An admin can publish over it.
REQUIRE_AGENT_TEST=true

# Limits (per organization): calls placed through the public API, and messages to Kaho Builder.
# API_CALLS_PER_MIN=10
# API_CALLS_PER_DAY=500
# ASSISTANT_PER_MIN=15
# ASSISTANT_PER_DAY=300

# --- Plans, minutes and the admin site (2026-11-15) -----------------------------------------------
# Billing: with it on (the default) an organization needs an ACTIVE plan to use the Studio, calls are charged to
# the minute against its balance, and a plan limits calls at once. Off only for trials: nothing is then locked or counted.
# BILLING_ENFORCED=true
# A plan starts when Kaho confirms payment (an admin presses "Start" or confirms a top-up). Set true only to let a
# plan start the moment it is chosen, e.g. for a free trial; the System check warns while it is on.
# SUBSCRIPTION_AUTO_ACTIVATE=false
# Shown with a plan or top-up request: how to pay Kaho. Plain text, up to 600 characters.
# BILLING_PAYMENT_INSTRUCTIONS=Pay by UPI to kaho@upi and quote the reference shown.
# Where "open the Studio as this person" lands (default: the first of ALLOWED_ORIGINS).
# STUDIO_URL=http://localhost:5173
# How often plans are checked for the end of their month, and how many billing requests (plan choices, top-ups) an
# organization may make an hour.
# BILLING_INTERVAL_MS=3600000
# BILLING_WRITES_PER_HOUR=60

# The admin site (the admin/ folder) has its OWN accounts, cookie and origin. Only these e-mail addresses can ever
# hold an admin account (exact match: no aliases), and sign-up also needs the setup code below. With no code set,
# nobody can sign up: it fails closed. Make the code long and random (openssl rand -base64 24), tell it to nobody
# else, and remove it again once both admins have signed up if you like.
ADMIN_EMAILS=adityanair5002@gmail.com,aayushimakker10@gmail.com
ADMIN_ORIGINS=http://localhost:5174
ADMIN_SIGNUP_CODE=
# ADMIN_AUTH_RATE_LIMIT_PER_MIN=10
# ADMIN_RATE_LIMIT_PER_MIN=300

# Kaho AI Studio API. Copy to backend/.env and fill in. Never commit backend/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8020
WEB_CONCURRENCY=1                 # worker processes; set to the CPU count in production
DATABASE_URL=postgres:///kaho_studio
# Supabase: Project Settings > Database > Connection string, the SESSION pooler or
# direct connection (port 5432), never the transaction pooler (6543). TLS is on
# for Supabase hosts automatically; give its CA certificate so the server is
# verified, not just encrypted (Project Settings > Database > SSL, download it):
# DATABASE_SSL_CA=/path/to/prod-ca-2021.crt
# DATABASE_SSL=off|require|verify   # forces a mode for any host
PGPOOL_MAX=10                     # per worker; workers x this must stay under Postgres max_connections
ALLOWED_ORIGINS=http://localhost:5173   # where the React app is served from
# ALLOWED_HOSTS=                  # defaults to localhost/127.0.0.1:PORT plus the origins' hosts
# TRUST_PROXY=true                # only behind a reverse proxy / load balancer you control
# COOKIE_SECURE=true              # default true when NODE_ENV=production
SECRETS_KEY=                      # openssl rand -hex 32  (encrypts provider credentials; keep it safe)
INTERNAL_API_TOKEN=               # openssl rand -hex 32  (shared with the voice service only)
# REDIS_URL=redis://127.0.0.1:6379  # shares rate-limit counts across processes and servers

# Placing calls (the same values as the voice service's .env)
PUBLIC_HOST=                      # the voice server's public host, e.g. abc.ngrok-free.app
WEBHOOK_SECRET=
MAX_CALL_DURATION_SECS=600
PLIVO_FROM_NUMBER=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# BULK_REPEAT_HOURS=24            # nobody is called again by a bulk call within this many hours of any call; 0 turns it off
# BULK_MAX_CONCURRENT=10           # calls at once across every bulk call; the voice server's WS_MAX_CONCURRENT_CALLS
# TRANSFER_NUMBER=                # makes the transfer tool show as ready
# TOOL_WEBHOOK_URL=               # makes the webhook tool show as ready
